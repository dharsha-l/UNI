{
  "name": "inspectai",
  "version": "1.0.0",
  "description": "InspectAI — Evidence-driven AI-assisted institutional inspection system",
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:ai": "cd ai-service && uvicorn main:app --port 8000 --reload",
    "dev:core": "cd core-backend && mvn spring-boot:run",
    "dev:gateway": "cd gateway && mvn spring-boot:run",
    "install:all": "cd backend && npm install && cd ../frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "workspaces": ["backend", "frontend"]
}
